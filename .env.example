APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000
SECURE_COOKIES=false
SESSION_HOURS=8
# DATABASE_PATH defaults to this project's data/vicam.sqlite3
# DATABASE_PATH=/absolute/path/to/private/data/vicam.sqlite3

# Configure verified company contact details and authenticated TLS SMTP.
# With these blank, enquiries still reach the staff dashboard.
COMPANY_EMAIL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=

# Dates and on-screen follow-up reminders use this time zone.
BUSINESS_TIMEZONE=Africa/Nairobi

# Certificate signing: disabled by default. See SIGNING_SETUP.md.
# Use test only locally; production requires certificate mode and a company certificate.
PDF_SIGNING_MODE=disabled
PDF_SIGNING_PFX=
PDF_SIGNING_PASSWORD=

# Each commercial pilot uses a separate database, origin and signing key.
BUSINESS_NAME=VICAM
BUSINESS_REGISTRATION=
# false hides client/scope and public original downloads; use private portal.
VERIFICATION_PUBLIC_DETAILS=true

# v2.5 operations: generate once with app.manage generate-encryption-key.
# Protect and back up separately. Required for MFA enrollment and invitation emails.
DATA_ENCRYPTION_KEY=
# Empty disables automatic backups. Use private storage outside the application static directory.
BACKUP_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Daily overdue-invoice jobs; off by default and still requires client opt-in.
REMINDER_EMAILS_ENABLED=false

# v2.6 optional Ask VICAM interpreter. Leave both empty for local navigation.
# Typed requests may be sent to OpenAI when staff select the AI checkbox.
# Choose a Responses API model supporting strict JSON-schema outputs; see ASK_VICAM.md.
ASSISTANT_AI_KEY=
ASSISTANT_AI_MODEL=
